# Port the server listens on. Render sets this automatically; 3001 is for local dev.
PORT=3001

# Comma-separated list of browser origins allowed to call this API.
# Enter bare origins only: no trailing slash, no notes, no quotes.
# Example: CLIENT_URL=https://roteva2.vercel.app
# Use * to allow any origin (Vercel preview deployments).
CLIENT_URL=http://localhost:5173

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start in production without this.
JWT_SECRET=replace-this-with-a-long-random-secret

# PostgreSQL connection string. Required in production.
DATABASE_URL=postgresql://user:password@host:port/database

# Optional. Leave unset to let the DATABASE_URL (sslmode) decide.
# Set to true if your host requires SSL, false to force it off.
# DATABASE_SSL=true
